# Supabase PostgreSQL connection string; replace every placeholder.
# Copy a pooler connection string from your Supabase project's Connect panel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Optional CA override (the Supabase CA is included by default).
# DATABASE_CA_FILE=database/certs/prod-ca-2021.crt
# DATABASE_CA_CERT=PEM_CERTIFICATE_TEXT
# Optional: set your public website origin on Vercel.
# APP_ORIGIN=https://your-project.vercel.app
# PORT=8001
# Set a private random value on Vercel to authorize daily complaint trash cleanup.
# CRON_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Password-reset OTP delivery (signup and login work without SMTP).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-sender@example.com
# SMTP_PASSWORD=YOUR_SMTP_PASSWORD
# SMTP_FROM=BSRU Workshop <your-sender@example.com>
