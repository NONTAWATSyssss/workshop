{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "database/**"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "crons": [{ "path": "/api/maintenance/complaints", "schedule": "0 20 * * *" }]
}
